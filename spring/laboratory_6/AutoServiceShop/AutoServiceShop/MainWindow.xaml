<Window x:Class="AutoServiceShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AutoServiceShop.Converters"
        xmlns:viewModels="clr-namespace:AutoServiceShop.ViewModels"
        xmlns:controls="clr-namespace:AutoServiceShop.Controls"
        Title="{DynamicResource MainWindowTitle}" 
        Height="600" Width="900"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico"
        Cursor="Resources/custom.cur">
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <viewModels:SortOrderToBooleanConverter x:Key="SortOrderConverter"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainDockPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <DockPanel x:Name="MainDockPanel" Opacity="1">
        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="15" Height="90">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="АВТОСЕРВИС ОТ НИКОЛАЯ" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Официальный каталог с 2026 года" FontSize="12" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer DockPanel.Dock="Left" Width="250" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Margin="5">
                <Expander Header="{DynamicResource ApplicationMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource SaveMenuItem}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource ProfileMenuItem}" Click="OpenProfile_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource UndoButton}" Command="{Binding UndoCommand}" 
                                Style="{StaticResource UndoButtonStyle}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource RedoButton}" Command="{Binding RedoCommand}" 
                                Style="{StaticResource RedoButtonStyle}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource ExitMenuItem}" Click="MenuItemExit_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource AddMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource AddButton}" Command="{Binding AddProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource EditMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource EditButton}" Command="{Binding EditProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource DeleteMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource DeleteButton}" Command="{Binding DeleteProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource RolesMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <RadioButton Content="{DynamicResource AdminRole}" IsChecked="{Binding IsAdmin}" GroupName="Role" Margin="5,2,0,2"/>
                        <RadioButton Content="{DynamicResource ClientRole}" IsChecked="{Binding IsClient}" GroupName="Role" Margin="5,2,0,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource SortMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <RadioButton Content="{DynamicResource NoSort}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.None}}"/>
                        <RadioButton Content="{DynamicResource PriceAsc}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.PriceAscending}}"/>
                        <RadioButton Content="{DynamicResource PriceDesc}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.PriceDescending}}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource FilterMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <TextBlock Text="{DynamicResource SearchPlaceholder}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="5,0,5,5"
                                 Height="35"
                                 Background="{DynamicResource SearchTextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource SearchTextBoxForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="{DynamicResource Category}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory}" 
                                  Margin="5,0,5,5"
                                  Height="30"
                                  DisplayMemberPath="."
                                  Background="{DynamicResource ComboBoxBackgroundBrush}"
                                  Foreground="{DynamicResource ComboBoxForegroundBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5" HorizontalAlignment="Stretch">
                            <StackPanel Width="95" Margin="0,0,5,0">
                                <TextBlock Text="{DynamicResource PriceFrom}" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=LostFocus}" 
                                         Width="90" 
                                         Height="30"
                                         Margin="0,0,0,0"
                                         Background="{DynamicResource TextBoxBackgroundBrush}"
                                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                            <StackPanel Width="95">
                                <TextBlock Text="{DynamicResource PriceTo}" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=LostFocus}" 
                                         Width="90" 
                                         Height="30"
                                         Margin="0,0,0,0"
                                         Background="{DynamicResource TextBoxBackgroundBrush}"
                                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Применить фильтр" 
                                Command="{Binding ApplyFilterCommand}" 
                                HorizontalAlignment="Stretch" 
                                Margin="5,5,5,5" 
                                Height="35"
                                Background="{DynamicResource FilterButtonBackgroundBrush}"
                                Foreground="{DynamicResource FilterButtonForegroundBrush}"
                                BorderBrush="{DynamicResource FilterButtonBorderBrush}"
                                BorderThickness="1"/>

                        <TextBlock Text="{Binding FilterError}" 
                                   Foreground="Red" 
                                   FontSize="11" 
                                   HorizontalAlignment="Center" 
                                   Margin="5,0,5,5" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource HelpMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource ContactInfoMenuItem}" Click="ShowContactInfo_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BackgroundBrush}">
            <ItemsControl ItemsSource="{Binding FilteredProducts}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ProductCardControl DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>