<Window x:Class="AutoServiceShop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Icon="../Resources/app.ico"
        Cursor="../Resources/custom.cur"
        Background="{DynamicResource ChildWindowBackground}">
    <Window.Resources>
        <!-- Конвертеры и прочее -->
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Имя" Grid.Row="0" Margin="0,5" FontWeight="Bold" Foreground="{DynamicResource ChildLabelForeground}"/>
            <TextBox Text="{Binding Profile.Name}" Grid.Row="1" Margin="0,0,0,15" Height="30"
                     Background="{DynamicResource ChildTextBoxBackground}"
                     Foreground="{DynamicResource ChildTextBoxForeground}"
                     BorderBrush="{DynamicResource ChildBorderBrush}"/>

            <TextBlock Text="Email" Grid.Row="2" Margin="0,5" FontWeight="Bold" Foreground="{DynamicResource ChildLabelForeground}"/>
            <TextBox Text="{Binding Profile.Email}" Grid.Row="3" Margin="0,0,0,15" Height="30"
                     Background="{DynamicResource ChildTextBoxBackground}"
                     Foreground="{DynamicResource ChildTextBoxForeground}"
                     BorderBrush="{DynamicResource ChildBorderBrush}"/>

            <TextBlock Text="Язык" Grid.Row="4" Margin="0,5" FontWeight="Bold" Foreground="{DynamicResource ChildLabelForeground}"/>
            <ComboBox Grid.Row="5" Margin="0,0,0,15" Height="30"
                      SelectedValue="{Binding Profile.Language}" 
                      SelectedValuePath="Tag"
                      Background="{DynamicResource ChildComboBoxBackground}"
                      Foreground="{DynamicResource ChildComboBoxForeground}"
                      BorderBrush="{DynamicResource ChildBorderBrush}">
                <ComboBoxItem Content="Русский" Tag="ru"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>

            <TextBlock Text="Тема" Grid.Row="6" Margin="0,5" FontWeight="Bold" Foreground="{DynamicResource ChildLabelForeground}"/>
            <ComboBox Grid.Row="7" Margin="0,0,0,15" Height="30"
                      SelectedValue="{Binding Profile.Theme}"
                      SelectedValuePath="Tag"
                      Background="{DynamicResource ChildComboBoxBackground}"
                      Foreground="{DynamicResource ChildComboBoxForeground}"
                      BorderBrush="{DynamicResource ChildBorderBrush}" Cursor="">
                <ComboBoxItem Content="Светлая" Tag="LightTheme"/>
                <ComboBoxItem Content="Тёмная" Tag="DarkTheme"/>
                <ComboBoxItem Content="Розовая" Tag="PinkTheme"/>
            </ComboBox>

            <CheckBox Content="Получать уведомления" Grid.Row="8" Margin="0,10" IsChecked="True"
                      Foreground="{DynamicResource ChildCheckBoxForeground}"/>

            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Width="100" Height="35" Margin="5" FontSize="14"
                        Background="{DynamicResource ChildButtonBackground}"
                        Foreground="{DynamicResource ChildButtonForeground}"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Width="80" Height="35" Margin="5" FontSize="14"
                        Background="{DynamicResource ChildButtonBackground}"
                        Foreground="{DynamicResource ChildButtonForeground}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>