<UserControl x:Class="AutoServiceShop.Controls.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ratingControl"
             MouseDoubleClick="UserControl_MouseDoubleClick">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="Star1" Content="★" FontSize="20" Click="Star_Click" Tag="1" Width="30" Height="30"/>
        <Button x:Name="Star2" Content="★" FontSize="20" Click="Star_Click" Tag="2" Width="30" Height="30"/>
        <Button x:Name="Star3" Content="★" FontSize="20" Click="Star_Click" Tag="3" Width="30" Height="30"/>
        <Button x:Name="Star4" Content="★" FontSize="20" Click="Star_Click" Tag="4" Width="30" Height="30"/>
        <Button x:Name="Star5" Content="★" FontSize="20" Click="Star_Click" Tag="5" Width="30" Height="30"/>
    </StackPanel>
</UserControl>