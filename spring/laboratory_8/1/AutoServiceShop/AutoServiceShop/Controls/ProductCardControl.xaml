<UserControl x:Class="AutoServiceShop.Controls.ProductCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoServiceShop.Converters"
             Width="200" Height="280">
    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource ProductCardStyle}"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseDown="OnMouseDown">
        <StackPanel>
            <Image Source="{Binding FirstImagePath, Converter={StaticResource ImagePathConverter}}"
                   Width="140" Height="90" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding ShortName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" 
                       Foreground="{DynamicResource SecondaryBrush}" 
                       FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="⭐ " Foreground="Gold"/>
                <TextBlock Text="{Binding Rating}" Foreground="Gray"/>
            </StackPanel>
            <TextBlock Style="{StaticResource InStockStyle}"/>
            <Button Content="{DynamicResource OrderButton}" Click="OrderButton_Click" Margin="0,5,0,0" Height="25"/>
        </StackPanel>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.9" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</UserControl>