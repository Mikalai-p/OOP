<Window x:Class="AutoServiceShop.Views.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoServiceShop.Controls"
        Title="{DynamicResource AddOrderWindowTitle}" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChildWindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource ProductLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProductComboBox" DisplayMemberPath="ShortName" SelectedValuePath="Id" Margin="5" Height="35"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource QuantityLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <controls:QuantitySelectorControl Grid.Row="1" Grid.Column="1" x:Name="QuantitySelector" Quantity="1" MinQuantity="1" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource CustomerNameLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CustomerNameTextBox" Margin="5" Height="35"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource AddButton}" Click="BtnAdd_Click" Width="90" Height="30" Margin="5"
                    Background="{DynamicResource ChildButtonBackground}"
                    Foreground="{DynamicResource ChildButtonForeground}"/>
            <Button Content="{DynamicResource CancelButton}" Click="BtnCancel_Click" Width="80" Height="30"
                    Background="{DynamicResource ChildButtonBackground}"
                    Foreground="{DynamicResource ChildButtonForeground}"/>
        </StackPanel>
    </Grid>
</Window>