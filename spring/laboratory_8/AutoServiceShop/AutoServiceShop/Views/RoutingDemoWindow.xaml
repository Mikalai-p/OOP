<Window x:Class="AutoServiceShop.Views.RoutingDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoServiceShop.Controls"
        Title="{DynamicResource RoutingDemoWindowTitle}" Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChildWindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource RoutingDemoHeader}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15" 
                   Foreground="{DynamicResource ChildLabelForeground}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>

        <!-- Контейнер с несколькими уровнями вложенности -->
        <Border Grid.Row="1" x:Name="OuterBorder" 
                BorderBrush="Red" BorderThickness="3" CornerRadius="5" Padding="15"
                Background="#20FF0000">
            <StackPanel>
                <TextBlock Text="{DynamicResource OuterBorderText}" FontWeight="Bold" Foreground="Red" Margin="0,0,0,5"/>

                <Border x:Name="MiddleBorder" 
                        BorderBrush="Blue" BorderThickness="3" CornerRadius="5" Padding="15"
                        Background="#200000FF">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MiddleBorderText}" FontWeight="Bold" Foreground="Blue" Margin="0,0,0,5"/>

                        <Border x:Name="InnerBorder" 
                                BorderBrush="Green" BorderThickness="3" CornerRadius="5" Padding="15"
                                Background="#2000FF00">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource InnerBorderText}" 
                                           FontWeight="Bold" Foreground="Green" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- Наши пользовательские элементы управления -->
                                <GroupBox Header="{DynamicResource RatingControlGroup}" Margin="0,5" Foreground="{DynamicResource ChildForeground}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ClickStarsText}" Margin="5" Foreground="{DynamicResource ChildForeground}"/>
                                        <controls:RatingControl x:Name="DemoRatingControl" Rating="3" Margin="5"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource QuantityControlGroup}" Margin="0,5" Foreground="{DynamicResource ChildForeground}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UseButtonsText}" Margin="5" Foreground="{DynamicResource ChildForeground}"/>
                                        <controls:QuantitySelectorControl x:Name="DemoQuantityControl" 
                                                                          Quantity="5" MinQuantity="0" MaxQuantity="10" 
                                                                          Margin="5"/>
                                    </StackPanel>
                                </GroupBox>

                                <TextBlock Text="{DynamicResource ControlsInsideText}" 
                                           FontStyle="Italic" Foreground="Gray" Margin="5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Панель с логом событий -->
        <GroupBox Grid.Row="2" Header="{DynamicResource EventLogGroup}" Margin="0,10,0,0"
                  Foreground="{DynamicResource ChildForeground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="EventLogListBox" Height="150" 
                         Background="{DynamicResource SurfaceBrush}" 
                         BorderBrush="{DynamicResource BorderBrush}"
                         SelectionMode="Single" Margin="0,0,5,0"
                         Foreground="{DynamicResource ChildForeground}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Button Content="{DynamicResource ClearLogButton}" Click="ClearLog_Click" Width="100" Height="30" Margin="0,0,0,5"
                            Background="{DynamicResource ChildButtonBackground}"
                            Foreground="{DynamicResource ChildButtonForeground}"/>
                    <Button Content="{DynamicResource ExplainButton}" Click="Explain_Click" Width="100" Height="30"
                            Background="{DynamicResource ChildButtonBackground}"
                            Foreground="{DynamicResource ChildButtonForeground}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>