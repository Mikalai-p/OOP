<Window x:Class="AutoServiceShop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProfileWindowTitle}" Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChildWindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource NameLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Profile.Name}" Margin="5" Height="35"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource EmailLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Profile.Email}" Margin="5" Height="35"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LanguageLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Profile.Language}" SelectedValuePath="Tag" Margin="5" Height="25">
            <ComboBoxItem Content="{DynamicResource RussianMenuItem}" Tag="ru"/>
            <ComboBoxItem Content="{DynamicResource EnglishMenuItem}" Tag="en"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource ThemeLabel}" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource ChildLabelForeground}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Profile.Theme}" SelectedValuePath="Tag" Margin="5" Height="25">
            <ComboBoxItem Content="{DynamicResource LightTheme}" Tag="LightTheme"/>
            <ComboBoxItem Content="{DynamicResource DarkTheme}" Tag="DarkTheme"/>
            <ComboBoxItem Content="{DynamicResource PinkTheme}" Tag="PinkTheme"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource SaveButton}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="90" Height="30" Margin="5"/>
            <Button Content="{DynamicResource CancelButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="90" Height="30"/>
        </StackPanel>
    </Grid>
</Window>