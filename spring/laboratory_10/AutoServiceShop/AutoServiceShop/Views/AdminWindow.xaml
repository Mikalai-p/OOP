<Window x:Class="AutoServiceShop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администрирование базы данных" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChildWindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Переключатель таблиц -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="rbProducts" Content="{DynamicResource ProductsTable}" IsChecked="True" GroupName="TableSelector" Margin="5" Checked="TableSelector_Checked"/>
            <RadioButton x:Name="rbCategories" Content="{DynamicResource CategoriesTable}" GroupName="TableSelector" Margin="5" Checked="TableSelector_Checked"/>
            <RadioButton x:Name="rbOrders" Content="{DynamicResource OrdersTable}" GroupName="TableSelector" Margin="5" Checked="TableSelector_Checked"/>
        </StackPanel>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="{DynamicResource AddButton}" Click="BtnAdd_Click" Width="90" Height="30" Margin="5"/>
            <Button Content="{DynamicResource EditButton}" Click="BtnEdit_Click" Width="90" Height="30" Margin="5"/>
            <Button Content="{DynamicResource UndoButton}" x:Name="btnUndo" Click="BtnUndo_Click" Width="90" Height="30" Margin="5" IsEnabled="False"/>
            <Button Content="{DynamicResource RedoButton}" x:Name="btnRedo" Click="BtnRedo_Click" Width="90" Height="30" Margin="5" IsEnabled="False"/>
        </StackPanel>

        <!-- DataGrid с автогенерацией и обработкой скрытия проблемных столбцов -->
        <DataGrid x:Name="dataGrid" Grid.Row="2" AutoGenerateColumns="True" 
                  SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceBrush}" 
                  BorderBrush="{DynamicResource BorderBrush}" 
                  Foreground="{DynamicResource ForegroundBrush}"
                  BeginningEdit="DataGrid_BeginningEdit"
                  CellEditEnding="DataGrid_CellEditEnding"
                  CurrentCellChanged="DataGrid_CurrentCellChanged"
                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/>

        <!-- Кнопки сохранения и закрытия -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource SaveButton}" x:Name="btnSave" Click="BtnSave_Click" Margin="5" Width="90" Height="30"/>
            <Button Content="{DynamicResource DeleteButton}" x:Name="btnDelete" Click="BtnDelete_Click" Margin="5" Width="80" Height="30"/>
            <Button Content="{DynamicResource CloseButton}" Click="BtnClose_Click" Margin="5" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>