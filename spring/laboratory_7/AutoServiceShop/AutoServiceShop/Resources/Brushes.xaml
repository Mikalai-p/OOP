<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные цвета приложения -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8C00"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="Green"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="Red"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCC"/>
</ResourceDictionary>