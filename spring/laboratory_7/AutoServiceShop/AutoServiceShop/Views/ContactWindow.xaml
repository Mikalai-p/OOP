<Window x:Class="AutoServiceShop.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Контактная информация"
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../Resources/app.ico"
        Cursor="../Resources/custom.cur"
        Background="{DynamicResource ChildWindowBackground}">
    <Window.Resources>
        <!-- Никаких локальных кистей – всё динамическое -->
    </Window.Resources>
    <Grid>
        <StackPanel Margin="25" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource ContactCompanyName}" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource ChildLabelForeground}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <Border BorderBrush="{DynamicResource ChildBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15" 
                    Margin="0,5"
                    Background="{DynamicResource ChildTextBoxBackground}">
                <StackPanel>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="{DynamicResource ContactPhone}" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource ChildForeground}"/>
                    </WrapPanel>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="{DynamicResource ContactEmail}" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource ChildForeground}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource CloseButton}" 
                    Width="120" Height="35" Margin="0,25,0,0" 
                    Click="CloseButton_Click"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ChildButtonBackground}"
                    Foreground="{DynamicResource ChildButtonForeground}"/>
        </StackPanel>
    </Grid>
</Window>