<UserControl x:Class="AutoServiceShop.Controls.QuantitySelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="quantitySelector">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="-" Click="Decrement_Click" Width="30" Height="30"/>
        <TextBox x:Name="QuantityTextBox" 
                 Text="{Binding Quantity, ElementName=quantitySelector, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Width="50" Height="30" TextAlignment="Center" Margin="5,0" 
                 LostFocus="QuantityTextBox_LostFocus"/>
        <Button Content="+" Click="Increment_Click" Width="30" Height="30"/>
    </StackPanel>
</UserControl>