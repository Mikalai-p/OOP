<Window x:Class="AutoServiceShop.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource InputDialogTitle}" Height="150" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChildWindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,5" Foreground="{DynamicResource ChildLabelForeground}"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,0,0,10" Height="35" 
                 Background="{DynamicResource ChildTextBoxBackground}"
                 Foreground="{DynamicResource ChildTextBoxForeground}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource ConfirmButton}" Click="BtnOk_Click" Width="110" Height="35" Margin="5"
                    Background="{DynamicResource ChildButtonBackground}"
                    Foreground="{DynamicResource ChildButtonForeground}"/>
            <Button Content="{DynamicResource CancelButton}" Click="BtnCancel_Click" Width="70" Height="35"
                    Background="{DynamicResource ChildButtonBackground}"
                    Foreground="{DynamicResource ChildButtonForeground}"/>
        </StackPanel>
    </Grid>
</Window>