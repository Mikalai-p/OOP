<Window x:Class="AutoServiceShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AutoServiceShop.Converters"
        xmlns:viewModels="clr-namespace:AutoServiceShop.ViewModels"
        Title="{DynamicResource MainWindowTitle}" 
        Height="600" Width="900"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico"
        Cursor="Resources/custom.cur">
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Стиль для Expander -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF8C00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" 
                                              DockPanel.Dock="Top" 
                                              Content="{TemplateBinding Header}" 
                                              ContentTemplate="{TemplateBinding HeaderTemplate}" 
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                              Background="#FFF5E6" 
                                              BorderBrush="#FF8C00" 
                                              BorderThickness="0,0,0,1" 
                                              FontWeight="Bold" 
                                              Foreground="#FF8C00" 
                                              Padding="8,5" 
                                              HorizontalContentAlignment="Left">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="0" 
                                                                      Data="M0,0 L6,4 L0,8 Z" 
                                                                      Fill="#FF8C00" 
                                                                      HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center" 
                                                                      Margin="2,0,5,0">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                    <Setter Property="Data" Value="M0,4 L6,0 L6,8 Z"/>
                                                                                    <Setter Property="Fill" Value="#FF8C00"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <ContentPresenter Grid.Column="1" 
                                                                                  Content="{TemplateBinding Content}" 
                                                                                  RecognizesAccessKey="True" 
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" 
                                                  Visibility="Collapsed" 
                                                  HorizontalAlignment="Stretch" 
                                                  Margin="10,5,5,5" 
                                                  DockPanel.Dock="Bottom"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточки товара -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#20000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="#40000000"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текста наличия -->
        <Style x:Key="InStockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Text" Value="{DynamicResource InStockLabel}"/>
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Text" Value="{DynamicResource OutOfStockLabel}"/>
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Конвертер для сортировки -->
        <viewModels:SortOrderToBooleanConverter x:Key="SortOrderConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Верхняя оранжевая шапка -->
        <Border DockPanel.Dock="Top" Background="#FF8C00" Padding="15" Height="90">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="АВТОСЕРВИС ОТ НИКОЛАЯ" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Официальный каталог с 2026 года" FontSize="12" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Вертикальное меню с Expander'ами (все закрыты) -->
        <ScrollViewer DockPanel.Dock="Left" Width="240" VerticalScrollBarVisibility="Auto" Background="#F5F5F5">
            <StackPanel Margin="5">

                <!-- Раздел "Приложение" -->
                <Expander Header="{DynamicResource ApplicationMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource SaveMenuItem}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource ExitMenuItem}" Click="MenuItemExit_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Добавить" (виден только администратору) -->
                <Expander Header="{DynamicResource AddMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource AddButton}" Command="{Binding AddProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Редактировать" (виден только администратору) -->
                <Expander Header="{DynamicResource EditMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource EditButton}" Command="{Binding EditProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Удалить" (виден только администратору) -->
                <Expander Header="{DynamicResource DeleteMenu}" IsExpanded="False"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource DeleteButton}" Command="{Binding DeleteProductCommand}" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Роли" -->
                <Expander Header="{DynamicResource RolesMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <RadioButton Content="{DynamicResource AdminRole}" IsChecked="{Binding IsAdmin}" GroupName="Role" Margin="5,2,0,2"/>
                        <RadioButton Content="{DynamicResource ClientRole}" IsChecked="{Binding IsClient}" GroupName="Role" Margin="5,2,0,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Язык" (ВОЗВРАЩЁН) -->
                <Expander Header="{DynamicResource LanguageMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource RussianMenuItem}" Click="SetRussian_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                        <Button Content="{DynamicResource EnglishMenuItem}" Click="SetEnglish_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Сортировка" -->
                <Expander Header="{DynamicResource SortMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <RadioButton Content="{DynamicResource NoSort}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.None}}"/>
                        <RadioButton Content="{DynamicResource PriceAsc}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.PriceAscending}}"/>
                        <RadioButton Content="{DynamicResource PriceDesc}" GroupName="SortOrder" Margin="5,2,0,2"
                                     IsChecked="{Binding CurrentSortOrder, Converter={StaticResource SortOrderConverter}, ConverterParameter={x:Static viewModels:SortOrder.PriceDescending}}"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Фильтр" -->
                <Expander Header="{DynamicResource FilterMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <TextBlock Text="{DynamicResource SearchPlaceholder}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,5"/>

                        <TextBlock Text="{DynamicResource Category}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="5,0,5,5"/>

                        <TextBlock Text="{DynamicResource PriceFrom}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding MinPrice}" Margin="5,0,5,5"/>

                        <TextBlock Text="{DynamicResource PriceTo}" Margin="5,5,0,0" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding MaxPrice}" Margin="5,0,5,5"/>
                    </StackPanel>
                </Expander>

                <!-- Раздел "Справка" -->
                <Expander Header="{DynamicResource HelpMenu}" IsExpanded="False">
                    <StackPanel Margin="0,5,0,5">
                        <Button Content="{DynamicResource ContactInfoMenuItem}" Click="ShowContactInfo_Click" HorizontalAlignment="Stretch" Margin="5,2,5,2"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Область отображения товаров (плитки) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredProducts}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCardStyle}"
                                Width="200"
                                Background="White"
                                MouseLeftButtonUp="ProductCard_MouseLeftButtonUp"
                                MouseDown="ProductCard_MouseDown">
                            <StackPanel>
                                <Image Source="{Binding FirstImagePath, Converter={StaticResource ImagePathConverter}}" 
                                       Width="140" Height="90" 
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ShortName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="#E67E22" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="⭐ " Foreground="Gold"/>
                                    <TextBlock Text="{Binding Rating}" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource InStockStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>